# Ponto Manager CloudPanel / Linux Headless
# Copie para .env e ajuste conforme o domínio/app no CloudPanel.

# ============================================================
# MODO DE PUBLICAÇÃO DE PORTAS
# ============================================================
# false = padrão seguro: serviços em 127.0.0.1, recomendado para CloudPanel/Nginx.
# true  = publica API/Web/Webhook/WebSocket em 0.0.0.0, útil quando você quer liberar
#         todas as portas diretamente no firewall/proxy externo.
ARGWS_PONTO_MANAGER_PUBLISH_ALL_PORTS=false

# Quando true, além de publicar os hosts, habilita Webhook e WebSocket no start.
ARGWS_PONTO_MANAGER_START_ALL_PORTS=false

# CloudPanel normalmente injeta PORT. Mantendo true, PORT tem prioridade sobre ARGWS_PONTO_MANAGER_WEB_PORT.
# Para rodar direto por terminal e respeitar exatamente ARGWS_PONTO_MANAGER_WEB_PORT, use false.
ARGWS_PONTO_MANAGER_RESPECT_CLOUDPANEL_PORT=true

# Host público usado quando ARGWS_PONTO_MANAGER_PUBLISH_ALL_PORTS=true.
ARGWS_PONTO_MANAGER_PUBLIC_BIND_HOST=0.0.0.0

# ============================================================
# API INTERNA / HEADLESS API
# ============================================================
# Em CloudPanel, mantenha 127.0.0.1 e exponha por WebPort/Nginx.
# Para publicar diretamente, use ARGWS_PONTO_MANAGER_PUBLISH_ALL_PORTS=true ou defina 0.0.0.0.
ARGWS_PONTO_MANAGER_API_HOST=127.0.0.1
ARGWS_PONTO_MANAGER_API_PORT=61001
ARGWS_PONTO_MANAGER_API_AUTO_START=true
ARGWS_PONTO_MANAGER_API_BASE_URL=http://127.0.0.1:61001
ARGWS_PONTO_MANAGER_API_SCALAR_ENABLED=true
ARGWS_PONTO_MANAGER_API_SCALAR_URL=http://127.0.0.1:61001/docs
ARGWS_PONTO_MANAGER_API_DOCS_PATH=/docs
ARGWS_PONTO_MANAGER_API_DOCS_PUBLIC_LOCAL=true
ARGWS_PONTO_MANAGER_API_REQUIRE_TOKEN=false
ARGWS_PONTO_MANAGER_API_ALLOW_PUBLIC_NETWORK=false
ARGWS_PONTO_MANAGER_API_CORS=false
ARGWS_PONTO_MANAGER_API_TOKEN_HEADER=X-App-Token
ARGWS_PONTO_MANAGER_API_TOKEN=

# ============================================================
# WEBPORT / BROWSER / PROXY LOCAL
# ============================================================
# Se PORT existir e ARGWS_PONTO_MANAGER_RESPECT_CLOUDPANEL_PORT=true, o launcher usa PORT.
ARGWS_PONTO_MANAGER_WEB_ENABLED=true
ARGWS_PONTO_MANAGER_WEB_HOST=127.0.0.1
ARGWS_PONTO_MANAGER_WEB_PORT=61002
ARGWS_PONTO_MANAGER_WEB_AUTO_START=true
ARGWS_PONTO_MANAGER_WEB_BIND_LAN=false
ARGWS_PONTO_MANAGER_WEB_DIST_DIR=./dist

# ============================================================
# WEBHOOK SERVICE
# ============================================================
ARGWS_PONTO_MANAGER_SERVICES_AUTO_START=true
ARGWS_PONTO_MANAGER_WEBHOOK_ENABLED=false
ARGWS_PONTO_MANAGER_WEBHOOK_AUTO_START=false
ARGWS_PONTO_MANAGER_WEBHOOK_HOST=127.0.0.1
ARGWS_PONTO_MANAGER_WEBHOOK_PORT=61003
ARGWS_PONTO_MANAGER_WEBHOOK_BASE_PATH=/webhooks
ARGWS_PONTO_MANAGER_WEBHOOK_TOKEN_REQUIRED=true
ARGWS_PONTO_MANAGER_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
ARGWS_PONTO_MANAGER_WEBHOOK_TOKEN=
ARGWS_PONTO_MANAGER_WEBHOOK_ALLOW_LAN=false
ARGWS_PONTO_MANAGER_WEBHOOK_ALLOW_EXTERNAL=false

# ============================================================
# WEBSOCKET SERVICE
# ============================================================
ARGWS_PONTO_MANAGER_WEBSOCKET_ENABLED=false
ARGWS_PONTO_MANAGER_WEBSOCKET_AUTO_START=false
ARGWS_PONTO_MANAGER_WEBSOCKET_HOST=127.0.0.1
ARGWS_PONTO_MANAGER_WEBSOCKET_PORT=61004
ARGWS_PONTO_MANAGER_WEBSOCKET_PATH=/ws
ARGWS_PONTO_MANAGER_WEBSOCKET_TOKEN_REQUIRED=true
ARGWS_PONTO_MANAGER_WEBSOCKET_TOKEN_QUERY=token
ARGWS_PONTO_MANAGER_WEBSOCKET_TOKEN_HEADER=X-WebSocket-Token
ARGWS_PONTO_MANAGER_WEBSOCKET_TOKEN=
ARGWS_PONTO_MANAGER_WEBSOCKET_ALLOW_LAN=false
ARGWS_PONTO_MANAGER_WEBSOCKET_ALLOW_EXTERNAL=false
ARGWS_PONTO_MANAGER_WEBSOCKET_HEARTBEAT_SECONDS=30

# ============================================================
# DIRETÓRIOS / BINÁRIO
# ============================================================
ARGWS_PONTO_MANAGER_BINARY=./bin/argws_ponto_manager
ARGWS_PONTO_MANAGER_DATA_DIR=./data
ARGWS_PONTO_MANAGER_LOGS_DIR=./logs
ARGWS_PONTO_MANAGER_ENV_FILE=./.env

# ============================================================
# SERVIDOR LINUX SEM DESKTOP
# ============================================================
ARGWS_PONTO_MANAGER_TRAY_ENABLED=false
ARGWS_PONTO_MANAGER_TRAY_MINIMIZE_TO_TRAY=false
ARGWS_PONTO_MANAGER_TRAY_CLOSE_TO_TRAY=false
ARGWS_PONTO_MANAGER_START_WITH_WINDOWS=false
ARGWS_PONTO_MANAGER_SERVICE_NAME=ArgwsPontoManagerServer
